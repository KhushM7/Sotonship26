{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "command -v pwsh >/dev/null 2>&1 || exit 0; pwsh -NoProfile -NonInteractive -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-git-commit-push.ps1\"",
            "onFailure": "block",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "command -v pwsh >/dev/null 2>&1 || exit 0; pwsh -NoProfile -NonInteractive -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-python.ps1\"",
            "timeout": 30,
            "statusMessage": "ruff on the edited Python file"
          }
        ]
      }
    ]
  }
}
