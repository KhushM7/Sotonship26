{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -NonInteractive -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-git-commit-push.ps1\"",
            "onFailure": "block",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
