#!/bin/sh
# Runs before every `git push`; the push is cancelled if formatting or lint fails.
# Takes a few seconds. Turn it on once per clone:  git config core.hooksPath .githooks
set -e
cd "$(git rev-parse --show-toplevel)"

PY=.venv/Scripts/python.exe
[ -x "$PY" ] || PY=.venv/bin/python
[ -x "$PY" ] || PY=python

echo "pre-push: ruff format --check"
"$PY" -m ruff format --check .
echo "pre-push: ruff check"
"$PY" -m ruff check .
echo "pre-push: all checks passed"
